# Copy to .dev.vars and fill in for local development (`npm run dev`).
# In deployed environments these are set with `npx wrangler secret put <NAME>`.
# .dev.vars is gitignored; this example file is committed.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFY_EMAIL=you@example.com

# Research-companion backend (the "bot" that produces URL → analysis).
# For local dev, run `npm run mock-bot` in another terminal — it serves
# the contract on http://localhost:8788. In prod, set BOT_API_URL to the
# real deployment and put BOT_API_KEY via `npx wrangler secret put`.
BOT_API_URL=http://localhost:8788
BOT_API_KEY=local-dev-secret
