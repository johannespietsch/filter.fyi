{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "filter-fyi",
	"main": "src/worker.ts",
	"compatibility_date": "2026-05-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"FROM_EMAIL": "Johannes from filter.fyi <hello@mail.filter.fyi>",
		"REPLY_TO_EMAIL": "hello@filter.fyi",
		// Cloudflare Access (Zero Trust) — set both in production via the
		// Cloudflare dashboard or `wrangler secret put`. Leaving them unset
		// makes admin.filter.fyi fail closed with 503 ("admin not configured").
		// CF_ACCESS_TEAM_DOMAIN example: "filter-fyi.cloudflareaccess.com"
		// CF_ACCESS_AUD: the "Application Audience (AUD) Tag" shown on the
		// Access application's Overview tab.
		"CF_ACCESS_TEAM_DOMAIN": "",
		"CF_ACCESS_AUD": ""
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "filter-fyi-waitlist",
			"database_id": "e9b7aa24-9b69-4e77-8569-b7cc7f065fcf"
		}
	]
}