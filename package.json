{
  "name": "filter-fyi",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test dev/*.test.mjs",
    "dev": "wrangler dev",
    "mock-bot": "node dev/mock-bot.mjs",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute filter-fyi-waitlist --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute filter-fyi-waitlist --remote --file=./schema.sql",
    "db:migrate:step5:local": "wrangler d1 execute filter-fyi-waitlist --local --file=./migrations/2026-05-19-summaries-rename.sql",
    "db:migrate:step5:remote": "wrangler d1 execute filter-fyi-waitlist --remote --file=./migrations/2026-05-19-summaries-rename.sql",
    "db:migrate:step5:fixup:local": "wrangler d1 execute filter-fyi-waitlist --local --file=./migrations/2026-05-19-summaries-rename-fixup.sql",
    "db:migrate:step5:fixup:remote": "wrangler d1 execute filter-fyi-waitlist --remote --file=./migrations/2026-05-19-summaries-rename-fixup.sql",
    "db:migrate:suggestion-feedback:local": "wrangler d1 execute filter-fyi-waitlist --local --file=./migrations/2026-06-07-suggestion-feedback.sql",
    "db:migrate:suggestion-feedback:remote": "wrangler d1 execute filter-fyi-waitlist --remote --file=./migrations/2026-06-07-suggestion-feedback.sql",
    "db:migrate:suggestion-events:local": "wrangler d1 execute filter-fyi-waitlist --local --file=./migrations/2026-06-08-suggestion-events.sql",
    "db:migrate:suggestion-events:remote": "wrangler d1 execute filter-fyi-waitlist --remote --file=./migrations/2026-06-08-suggestion-events.sql",
    "db:list:local": "wrangler d1 execute filter-fyi-waitlist --local --command='SELECT id, email, challenges, source, created_at FROM waitlist ORDER BY created_at DESC LIMIT 20'",
    "db:list:remote": "wrangler d1 execute filter-fyi-waitlist --remote --command='SELECT id, email, challenges, source, created_at FROM waitlist ORDER BY created_at DESC LIMIT 20'",
    "db:users:local": "wrangler d1 execute filter-fyi-waitlist --local --command='SELECT id, email, created_at, last_login_at FROM users ORDER BY created_at DESC LIMIT 20'",
    "db:users:remote": "wrangler d1 execute filter-fyi-waitlist --remote --command='SELECT id, email, created_at, last_login_at FROM users ORDER BY created_at DESC LIMIT 20'"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "jose": "^6.2.3"
  }
}
